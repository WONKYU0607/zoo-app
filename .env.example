# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 에서 복사해 넣는다.
# 브라우저에 실려 나가는 공개 값이라 비밀이 아니다.
# 실제 보호는 Firestore 보안 규칙이 한다.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
VITE_FB_DB_URL=

# 게임 서버 주소. **이게 비어 있으면 온라인 대전이 통째로 안 된다.**
# 앱(APK)을 만들 때도 이 값이 들어간 채로 빌드해야 한다 — 빌드 시점에 박힌다.
VITE_GAME_SERVER=https://zoo-president.fly.dev

# 광고 — AdMob 앱 번호. 안드로이드 설정에 들어간다(npm run sync 가 자동으로 넣는다).
# 비워 두면 구글 시험용 번호를 쓴다. **없으면 앱이 켜지자마자 죽는다.**
VITE_AD_APP_ID=

# 광고 단위 번호. 비워 두면 **구글 시험용 광고**가 뜬다(돈 안 됨).
# AdMob 에서 앱을 등록하고 받은 진짜 번호를 출시 직전에 넣는다.
# 개발 중에 진짜 번호로 광고를 누르면 계정이 정지될 수 있다.
VITE_AD_REWARD_ID=
VITE_AD_INTER_ID=
