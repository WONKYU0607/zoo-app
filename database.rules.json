{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        "seats": {
          "$i": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('rooms').child($code).child('host').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChild('uid')"
          }
        },
        "score": {
          "$i": {
            ".write": "auth != null"
          }
        },
        "moves": {
          "$seq": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length < 24"
          }
        },
        "round": {
          ".write": "auth != null"
        },
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "touchedAt": {
          ".write": "auth != null"
        },
        "roundNo": {
          ".write": "auth != null"
        },
        "lastWinner": {
          ".write": "auth != null"
        },
        "revolution": {
          ".write": "auth != null"
        },
        "paid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "opts": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        },
        "phase": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        },
        "host": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
        },
        "seed": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid"
        }
      }
    },
    "hands": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
